{
  "name": "cine-mate",
  "version": "1.2.0",
  "description": "Cine - an expressive Windows desktop companion",
  "main": "./out/main/index.js",
  "author": "cine-verse",
  "license": "MIT",
  "scripts": {
    "speech:setup": "node scripts/setup-speech.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test scripts/regressions.test.cjs",
    "start": "electron ./out/main/index.js",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.cineverse.mate",
    "productName": "CineMate",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      "assets/**/*",
      "gemini.key"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": true,
      "icon": "build/cine.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CineMate"
    }
  }
}
